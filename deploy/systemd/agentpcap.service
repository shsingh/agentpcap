# agentpcap.service — the host-native placement.
#
# Spec: docs/spec.md#10-deployment. The service runs non-root with the
# ambient capability set the tap needs and nothing more: CAP_BPF and
# CAP_PERFMON for the eBPF probe loads, CAP_DAC_READ_SEARCH for the
# /proc reads, and the ledger write access rides the state directory.
# The unit never writes to any traffic path; the tap is read-only.

[Unit]
Description=agentpcap - a read-only, protocol-aware tap for agent tool calls
Documentation=https://github.com/shsingh/agentpcap
After=network.target

[Service]
Type=simple
User=agentpcap
Group=agentpcap
# the binary path: the release's install face (the maintainer adjusts
# the prefix at package time)
ExecStart=/usr/local/bin/agentpcap tap --ledger /var/lib/agentpcap/ledger.jsonl --duration 0
# the privacy face: the state directory and the ledger ride
# owner-only - captured payloads never become world-readable
StateDirectory=agentpcap
StateDirectoryMode=0700
UMask=0077
# the capability set: documented in deploy/README.md, nothing else
# CAP_SYS_PTRACE rides the set: Yama's ptrace scope only grants a
# CAP_SYS_PTRACE holder the read of another user's live /proc/<pid>/fd
# link - without it every foreign-user writer resolves `unresolved`
# (deploy/README.md states the justification)
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
# the service carries no telemetry of its own
NoNewPrivileges=on
ProtectSystem=strict
ProtectHome=on
ProtectKernelTunables=on
ProtectKernelModules=on
PrivateTmp=on
ReadWritePaths=-/var/lib/agentpcap
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
